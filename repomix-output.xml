<file path="app/globals.css">
/* ============================================
   Base Reset & Font
   ============================================ */
*, *::before, *::after { box-sizing: border-box; }

html, body {
  height: 100%;
  font-family: 'Poppins', sans-serif;
  font-size: 13px;
  font-weight: 400;
  background-color: #f5f8fa;
  color: #181c32;
  -webkit-font-smoothing: antialiased;
}

a { text-decoration: none; color: inherit; }

/* ============================================
   Layout
   ============================================ */
#kt_header {
  height: 65px;
  display: flex;
  align-items: stretch;
  padding: 0 24px;
}

#kt_wrapper { width: 100%; }

#kt_content { flex: 1; }

#kt_content_container {
  padding: 24px;
  width: 100%;
  max-width: 1600px;
  margin: 0 auto;
}

.min-vh-100 { min-height: 100vh; }
.cursor-pointer { cursor: pointer; }

/* ============================================
   Card custom
   ============================================ */
.card { border: none; box-shadow: 0 0 20px 0 rgba(76,87,125,.02); }
.card-header { border-bottom: 1px solid #eff2f5; }

/* ============================================
   Nav line tabs (profile tabs)
   ============================================ */
.nav-line-tabs .nav-item .nav-link {
  color: #a1a5b7;
  border-bottom: 2px solid transparent;
  padding: 0.75rem 0;
  margin-right: 1.5rem;
  font-weight: 600;
  transition: color .2s ease;
}
.nav-line-tabs .nav-item .nav-link:hover,
.nav-line-tabs .nav-item .nav-link.active {
  color: #009ef7;
  border-bottom-color: #009ef7;
}

/* ============================================
   Badges custom colors
   ============================================ */
.badge-danger  { background-color: #f1416c; color: #fff; padding: 4px 8px; border-radius: 6px; font-size: 11px; }
.badge-success { background-color: #50cd89; color: #fff; padding: 4px 8px; border-radius: 6px; font-size: 11px; }
.badge-warning { background-color: #ffc700; color: #fff; padding: 4px 8px; border-radius: 6px; font-size: 11px; }
.badge-light-primary { background-color: #f1faff; color: #009ef7; padding: 3px 8px; border-radius: 6px; font-size: 11px; }

/* ============================================
   Form controls custom
   ============================================ */
.form-control-solid {
  background-color: #f5f8fa;
  border-color: #f5f8fa;
  color: #5e6278;
}
.form-control-solid:focus {
  background-color: #eef3f7;
  border-color: #eef3f7;
  box-shadow: none;
}

/* ============================================
   Header styles
   ============================================ */
#kt_header .container {
  max-width: 100%;
  padding: 0 24px;
}

.userMenu {
  border-radius: 6px;
  background: rgba(255,255,255,.1);
}

.logout {
  display: flex;
  align-items: center;
  padding: 0 12px;
  color: rgba(255,255,255,.75);
  transition: color .2s ease;
}
.logout:hover { color: #fff; }

/* ============================================
   Footer
   ============================================ */
.footer {
  background-color: #fff;
  border-top: 1px solid #eff2f5;
  padding: 1rem 24px;
}

/* ============================================
   Spinner override
   ============================================ */
.spinner-border-sm { width: 1rem; height: 1rem; }

/* ============================================
   Leaflet map container
   ============================================ */
.leaflet-container { border-radius: 8px; }

/* ============================================================
   Dashboard Theme — Dark Glassy Business
   ============================================================ */

.dashboard-root {
  min-height: 100vh;
  background: #060b18;
  color: #e2e8f0;
  position: relative;
  overflow-x: hidden;
}

/* (grid dihapus — mengganggu grafik) */

/* Background blobs */
.dash-blob {
  position: fixed;
  border-radius: 50%;
  filter: blur(100px);
  pointer-events: none;
  z-index: 0;
  animation: blobFloat 10s ease-in-out infinite;
}
.dash-blob-1 {
  width: 600px; height: 600px;
  background: radial-gradient(circle, rgba(14,165,233,0.13), transparent 70%);
  top: -200px; left: -150px;
  animation-delay: 0s;
}
.dash-blob-2 {
  width: 500px; height: 500px;
  background: radial-gradient(circle, rgba(99,102,241,0.11), transparent 70%);
  bottom: 5%; right: -120px;
  animation-delay: -4s;
}
.dash-blob-3 {
  width: 350px; height: 350px;
  background: radial-gradient(circle, rgba(20,184,166,0.09), transparent 70%);
  top: 35%; left: 60%;
  animation-delay: -7s;
}

/* ===== Header ===== */
.dash-header {
  position: sticky;
  top: 0;
  z-index: 100;
  width: 100%;
  height: 65px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32px;
  background: rgba(6,11,24,0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid rgba(255,255,255,0.07);
}

.dash-header-left {
  display: flex;
  align-items: center;
  gap: 12px;
}

.dash-header-logo {
  width: 36px; height: 36px;
  background: linear-gradient(135deg, #0ea5e9, #6366f1);
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  color: white;
  box-shadow: 0 4px 14px rgba(14,165,233,0.4);
  flex-shrink: 0;
}

.dash-header-title-text {
  font-size: 17px;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: -0.3px;
}

.dash-header-right {
  display: flex;
  align-items: center;
  gap: 16px;
}

.dash-user-info { text-align: right; }

.dash-user-name {
  font-size: 13px;
  font-weight: 600;
  color: rgba(255,255,255,0.8);
  line-height: 1.3;
}

.dash-user-role {
  font-size: 11px;
  color: rgba(255,255,255,0.3);
}

.dash-logout-btn {
  width: 36px; height: 36px;
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.09);
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255,255,255,0.45);
  cursor: pointer;
  transition: all 0.2s ease;
  font-size: 16px;
}
.dash-logout-btn:hover {
  background: rgba(239,68,68,0.15);
  border-color: rgba(239,68,68,0.3);
  color: #fca5a5;
}

/* ===== Main content area ===== */
.dash-content {
  position: relative;
  z-index: 2;
  padding: 32px;
  max-width: 1500px;
  margin: 0 auto;
}

/* ===== Glass Card (generic — inner chart cards) ===== */
.glass-card {
  background: #111d35;
  border: 1px solid rgba(255,255,255,0.07);
  border-radius: 16px;
  box-shadow: 0 4px 16px rgba(0,0,0,0.2);
  margin-bottom: 24px;
}

.glass-card-header {
  padding: 18px 24px 16px;
  border-bottom: 1px solid rgba(255,255,255,0.06);
  display: flex;
  align-items: center;
}

.glass-card-title {
  font-size: 14px;
  font-weight: 600;
  color: rgba(255,255,255,0.8);
  margin: 0;
}

.glass-card-body { padding: 24px; }

/* ===== Profile Card ===== */
.profile-glass-card {
  background: #0d1526;
  border: 1px solid rgba(255,255,255,0.07);
  border-radius: 20px;
  box-shadow: 0 8px 32px rgba(0,0,0,0.35);
  margin-bottom: 28px;
}

.profile-card-inner { padding: 28px 28px 0; }

.profile-photo-box {
  width: 108px; height: 108px;
  border-radius: 16px;
  overflow: hidden;
  border: 2px solid rgba(255,255,255,0.1);
  flex-shrink: 0;
  margin-right: 28px;
  margin-bottom: 16px;
  background: rgba(255,255,255,0.05);
  display: flex;
  align-items: center;
  justify-content: center;
}
.profile-photo-box img {
  width: 100%; height: 100%;
  object-fit: cover;
  object-position: 50% 30%;
}

.profile-name {
  font-size: 22px;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: -0.3px;
  margin-right: 10px;
}

.profile-jabatan-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 8px;
  margin-bottom: 18px;
}
.profile-jabatan-text {
  font-size: 13px;
  color: rgba(255,255,255,0.38);
}

/* Stat boxes */
.profile-stats-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 8px;
}

.profile-stat-box {
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 14px;
  padding: 14px 20px;
  min-width: 148px;
}

.profile-stat-value {
  font-size: 17px;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.3;
}

.profile-stat-label {
  font-size: 10px;
  color: rgba(255,255,255,0.32);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.9px;
  margin-top: 4px;
}

/* Badge overrides for dark theme */
.dashboard-root .badge-danger  { background: rgba(239,68,68,0.18);   color: #fca5a5; border: 1px solid rgba(239,68,68,0.3); }
.dashboard-root .badge-success { background: rgba(16,185,129,0.18);  color: #6ee7b7; border: 1px solid rgba(16,185,129,0.3); }
.dashboard-root .badge-warning { background: rgba(245,158,11,0.18);  color: #fcd34d; border: 1px solid rgba(245,158,11,0.3); }
.dashboard-root .badge-light-primary { background: rgba(14,165,233,0.15); color: #38bdf8; border: 1px solid rgba(14,165,233,0.2); }

/* ===== Tab nav ===== */
.dash-tab-wrap {
  border-top: 1px solid rgba(255,255,255,0.06);
  margin-top: 22px;
}

.dash-tab-list {
  display: flex;
  list-style: none;
  padding: 0;
  margin: 0;
  gap: 2px;
  overflow-x: auto;
}

.dash-tab-btn {
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 14px 18px;
  color: rgba(255,255,255,0.32);
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  border-bottom: 2px solid transparent;
  transition: all 0.2s ease;
  white-space: nowrap;
  user-select: none;
  margin-bottom: -1px;
}
.dash-tab-btn:hover { color: rgba(255,255,255,0.65); }
.dash-tab-btn.active-tab {
  color: #38bdf8;
  border-bottom-color: #38bdf8;
}

/* ===== Section wrappers (Overview/Digital/Alpro sections) ===== */
.dash-section {
  background: #0d1526;
  border: 1px solid rgba(255,255,255,0.07);
  border-radius: 20px;
  padding: 24px;
  margin-bottom: 24px;
}

.dash-section-header {
  margin-bottom: 20px;
  padding-bottom: 14px;
  border-bottom: 1px solid rgba(255,255,255,0.06);
}

.dash-section-title {
  font-size: 15px;
  font-weight: 700;
  color: rgba(255,255,255,0.75);
  margin: 0;
}

/* ===== Footer ===== */
.dash-footer {
  position: relative;
  z-index: 2;
  border-top: 1px solid rgba(255,255,255,0.06);
  padding: 22px 32px;
  margin-top: 32px;
}

.dash-footer-copy {
  font-size: 12px;
  color: rgba(255,255,255,0.18);
}

/* ===== Search dark override ===== */
.dashboard-root .form-control-solid {
  background: rgba(255,255,255,0.06) !important;
  border: 1px solid rgba(255,255,255,0.09) !important;
  color: #ffffff !important;
  border-radius: 12px;
}
.dashboard-root .form-control-solid:focus {
  background: rgba(255,255,255,0.09) !important;
  border-color: rgba(14,165,233,0.5) !important;
  box-shadow: 0 0 0 3px rgba(14,165,233,0.1) !important;
}
.dashboard-root .form-control-solid::placeholder {
  color: rgba(255,255,255,0.2) !important;
}

.search-dark-dropdown {
  background: #0d1526;
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 12px;
  box-shadow: 0 16px 40px rgba(0,0,0,0.5);
}

.search-dark-item {
  color: rgba(255,255,255,0.65);
  border-bottom: 1px solid rgba(255,255,255,0.05);
  transition: background 0.15s;
  cursor: pointer;
}
.search-dark-item:hover { background: rgba(255,255,255,0.05); }
.search-dark-item:last-child { border-bottom: none; }

/* ===== Spinner ===== */
.dashboard-root .spinner-border { color: #0ea5e9; }

/* ============================================
   Login Page — Modern Glassy Business
   ============================================ */
.login-root {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #060b18;
  position: relative;
  overflow: hidden;
}

/* Animated gradient background */
.login-root::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse at 15% 55%, rgba(14,165,233,0.18) 0%, transparent 55%),
    radial-gradient(ellipse at 85% 15%, rgba(99,102,241,0.18) 0%, transparent 55%),
    radial-gradient(ellipse at 65% 85%, rgba(20,184,166,0.12) 0%, transparent 50%);
  pointer-events: none;
}

/* Floating blobs */
.login-blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(90px);
  pointer-events: none;
  animation: blobFloat 8s ease-in-out infinite;
}
.login-blob-1 {
  width: 520px; height: 520px;
  background: radial-gradient(circle, rgba(14,165,233,0.22), transparent 70%);
  top: -160px; left: -120px;
  animation-delay: 0s;
}
.login-blob-2 {
  width: 420px; height: 420px;
  background: radial-gradient(circle, rgba(99,102,241,0.22), transparent 70%);
  bottom: -100px; right: -100px;
  animation-delay: -3s;
}
.login-blob-3 {
  width: 280px; height: 280px;
  background: radial-gradient(circle, rgba(20,184,166,0.18), transparent 70%);
  top: 50%; left: 65%;
  animation-delay: -5s;
}

@keyframes blobFloat {
  0%, 100% { transform: translate(0, 0) scale(1); }
  33%       { transform: translate(20px, -30px) scale(1.05); }
  66%       { transform: translate(-15px, 20px) scale(0.97); }
}

/* Grid overlay subtle */
.login-root::after {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(255,255,255,0.015) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.015) 1px, transparent 1px);
  background-size: 60px 60px;
  pointer-events: none;
}

/* Card */
.login-card {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 450px;
  margin: 20px;
  background: rgba(255,255,255,0.04);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1px solid rgba(255,255,255,0.09);
  border-radius: 28px;
  padding: 52px 48px;
  box-shadow:
    0 32px 64px rgba(0,0,0,0.5),
    0 0 0 1px rgba(255,255,255,0.04),
    inset 0 1px 0 rgba(255,255,255,0.08);
}

/* Brand */
.login-brand { text-align: center; margin-bottom: 40px; }

.login-logo {
  width: 68px; height: 68px;
  background: linear-gradient(135deg, #0ea5e9 0%, #6366f1 100%);
  border-radius: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 18px;
  font-size: 30px;
  color: white;
  box-shadow: 0 10px 30px rgba(14,165,233,0.45);
}

.login-title {
  font-size: 28px;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 6px;
  letter-spacing: -0.5px;
}

.login-subtitle {
  font-size: 11px;
  color: rgba(255,255,255,0.35);
  margin-bottom: 0;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  font-weight: 500;
}

/* Alert */
.login-alert {
  background: rgba(239,68,68,0.12);
  border: 1px solid rgba(239,68,68,0.25);
  color: #fca5a5;
  border-radius: 12px;
  padding: 13px 16px;
  margin-bottom: 22px;
  font-size: 13px;
  display: flex;
  align-items: center;
}

/* Field */
.login-field { margin-bottom: 22px; }

.login-label {
  display: block;
  font-size: 11px;
  font-weight: 600;
  color: rgba(255,255,255,0.5);
  margin-bottom: 9px;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.login-input-wrap {
  position: relative;
  display: flex;
  align-items: center;
}

.login-input-icon {
  position: absolute;
  left: 16px;
  color: rgba(255,255,255,0.25);
  font-size: 15px;
  pointer-events: none;
  z-index: 1;
  transition: color 0.2s;
}

.login-input {
  width: 100%;
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.09);
  border-radius: 14px;
  padding: 15px 48px;
  color: #ffffff;
  font-family: 'Poppins', sans-serif;
  font-size: 13.5px;
  transition: all 0.2s ease;
  outline: none;
}
.login-input::placeholder { color: rgba(255,255,255,0.18); }
.login-input:focus {
  border-color: rgba(14,165,233,0.55);
  background: rgba(255,255,255,0.09);
  box-shadow: 0 0 0 3px rgba(14,165,233,0.12);
}
.login-input:focus + .login-input-icon,
.login-input-wrap:focus-within .login-input-icon {
  color: rgba(14,165,233,0.7);
}

/* Eye toggle */
.login-eye {
  position: absolute;
  right: 14px;
  background: none;
  border: none;
  color: rgba(255,255,255,0.25);
  cursor: pointer;
  padding: 4px 6px;
  font-size: 15px;
  transition: color 0.2s;
  z-index: 1;
}
.login-eye:hover { color: rgba(255,255,255,0.65); }

/* Submit button */
.login-btn {
  width: 100%;
  padding: 16px;
  background: linear-gradient(135deg, #0ea5e9 0%, #6366f1 100%);
  border: none;
  border-radius: 14px;
  color: #ffffff;
  font-family: 'Poppins', sans-serif;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  margin-top: 10px;
  transition: all 0.25s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8px 28px rgba(14,165,233,0.35);
  letter-spacing: 0.3px;
}
.login-btn:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow: 0 14px 36px rgba(14,165,233,0.45);
  background: linear-gradient(135deg, #38bdf8 0%, #818cf8 100%);
}
.login-btn:active:not(:disabled) { transform: translateY(0); }
.login-btn:disabled { opacity: 0.45; cursor: not-allowed; }

/* Footer note */
.login-divider {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 28px 0 0;
}
.login-divider-line {
  flex: 1;
  height: 1px;
  background: rgba(255,255,255,0.07);
}
.login-footer-text {
  font-size: 11px;
  color: rgba(255,255,255,0.18);
  letter-spacing: 0.5px;
  white-space: nowrap;
}
