    @each $name, $value in $grays-dark {
        --kt-gray-#{$name}: #{$value};
    }

    // Grey rgba colors
    @each $name, $value in $grays-dark {
        --kt-gray-#{$name}-rgb: #{to-rgb($value)};
    }

    // Contextual colors
    @each $name, $value in $theme-colors-dark {
        --kt-#{$name}: #{$value};
